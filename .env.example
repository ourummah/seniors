# Supabase project (Settings > API). The first two are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Used for admin approvals, account deletion and scheduled jobs.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://seniorsmoneyfinder.com

# Scheduled jobs (any long random string). Vercel sends it automatically to cron routes.
CRON_SECRET=

# Alerts by email (Resend) and text message (Twilio). Leave blank to switch that channel off.
RESEND_API_KEY=
ALERTS_FROM_EMAIL=Seniors Money Finder <alerts@seniorsmoneyfinder.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
